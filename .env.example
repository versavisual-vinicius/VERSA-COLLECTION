# Google Cloud / Google Drive API - Service Account
GOOGLE_PROJECT_ID="seu-project-id"
GOOGLE_CLIENT_EMAIL="seu-bot@seu-projeto.iam.gserviceaccount.com"
GOOGLE_CLIENT_ID="000000000000000000000"
GOOGLE_PRIVATE_KEY_ID="hash-id-da-chave-privada"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID="id-da-pasta-raiz-no-google-drive"
GOOGLE_DRIVE_FOLDER_ID="id-da-pasta-raiz-no-google-drive"

# Frontend
VITE_API_ENABLED="false"
VITE_ADMIN_TOKEN=""

# Backend (Google Cloud Run / AlloyDB PostgreSQL 17)
DATABASE_URL="postgresql://postgres:senha@host:5432/versa_collection"
ADMIN_TOKEN="sua-senha-master-administrativa"
RATE_LIMIT_SECRET="gere-outros-32-bytes-aleatorios"
ALLOWED_ORIGINS="http://localhost:5173,https://seu-dominio.com"
