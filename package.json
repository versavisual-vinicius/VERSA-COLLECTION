{
  "name": "versa-collection",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build && pnpm build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node server.mjs",
    "typecheck": "tsc && tsc -p tsconfig.api.json",
    "lint": "eslint . --max-warnings 0",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:drive": "node scripts/sync-drive-collections.mjs",
    "sync:sql": "node scripts/seed-supabase-collections.mjs",
    "seed:sql": "node scripts/seed-supabase-collections.mjs",
    "sync:supabase": "node scripts/seed-supabase-collections.mjs",
    "seed:supabase": "node scripts/seed-supabase-collections.mjs",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "googleapis": "^188.0.0",
    "jszip": "^3.10.2",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.49",
    "supabase": "2.122.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
